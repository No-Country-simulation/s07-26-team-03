# Spring profile: dev | mock | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (docker-compose levanta Postgres automáticamente; cambiar a localhost si usás BD externa)
DB_HOST=db
DB_PORT=5432
DB_NAME=physaflow_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# JWT (HS256 requiere >= 256 bits)
JWT_SECRET=replace-with-256-bit-secret

# SMTP (e.g. Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
