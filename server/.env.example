# PhysaFlow server - environment variables
# Copy this file to .env and edit values as needed:
#   cp .env.example .env
#
# docker-compose reads this file automatically (variables without export).

# Server port exposed on the host
SERVER_PORT=8080

# Active Spring profile: mock | dev | prod
# Default: mock (no DB, only stubs, ideal for frontend integration in Sprint 0/1)
SPRING_PROFILES_ACTIVE=mock

# ---------------------------------------------------------------------------
# Sprint 1+ (uncomment when switching to dev or prod profile)
# ---------------------------------------------------------------------------
# DATABASE_URL=jdbc:postgresql://<host>:<port>/<db>?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# Electricity price (USD/MWh) used for waste USD calculation
# PRICE_USD_PER_MWH=100.00
